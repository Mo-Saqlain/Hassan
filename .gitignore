# ───────── Env / Secrets ─────────
.env
.env.local
.env.*.local
.env.development
.env.production

# ───────── Local working data (NEVER commit) ─────────
# Consolidated home for operational data + secrets that live only on disk:
#   local/secrets/       real backend .env(s)
#   local/mobile-signing/ release keystore + gradle.properties (plaintext pwds)
#   local/db/            live erp.sqlite + logs
#   local/backups/       backup snapshots (dev + live)
#   local/repo-bundle/   git bundle mirrors
#   local/misc/          stray assets
local/

# ───────── Build output ─────────
dist/
build/
out/
*.tsbuildinfo

# ───────── ERP local databases ─────────
erp-backend/erp.sqlite
erp-backend/erp.sqlite-journal
erp-backend/erp.sqlite-shm
erp-backend/erp.sqlite-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ───────── Backup snapshots ─────────
# Written by /api/backup; path overridable via BACKUP_DIR env var.
backups/
erp-backend/backups/

# ───────── Electron ─────────
